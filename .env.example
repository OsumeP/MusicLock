# Copiar a .env (que NO se sube a git):  cp .env.example .env
# Valores solo para desarrollo local.

# Django
DJANGO_SECRET_KEY=change-me-dev-secret-at-least-32-characters-long
DJANGO_DEBUG=True

# PostgreSQL
POSTGRES_DB=musiclock
POSTGRES_USER=musiclock
POSTGRES_PASSWORD=musiclock

# Almacenamiento de blobs cifrados: minio | local
STORAGE_BACKEND=minio

# MinIO (también son las credenciales de la consola en http://localhost:9001)
MINIO_ROOT_USER=musiclock
MINIO_ROOT_PASSWORD=musiclock-dev-secret
MINIO_BUCKET=musiclock-blobs
